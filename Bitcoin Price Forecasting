'SMA7', 'SMA15', 'SMA30',\n","    'EMA7', 'EMA15', 'EMA30', 'RSI', 'Upper_Band', 'Lower_Band'\n","]\n","df_lstm_pytorch_selected = df_lstm_pytorch[features_to_scale + ['Date']].copy()\n","\n","# FIX: Drop rows with NaN values from the selected features and their corresponding dates.\n","initial_rows_before_dropna = len(df_lstm_pytorch_selected)\n","df_lstm_pytorch_selected.dropna(inplace=True)\n","rows_dropped_by_dropna = initial_rows_before_dropna - len(df_lstm_pytorch_selected)\n","print(f\"Removed {rows_dropped_by_dropna} rows with NaNs from selected features. New shape: {df_lstm_pytorch_selected.shape}\")\n","\n","# FIX: Extract the cleaned dates series *after* dropna, before scaling features\n","cleaned_dates_series = df_lstm_pytorch_selected['Date'].copy()\n","# Now drop 'Date' from df_lstm_pytorch_selected as it's not a feature to be scaled\n","df_lstm_pytorch_selected.drop(columns=['Date'], inplace=True)\n","\n","\n","scalers_pytorch_lstm = {}\n","\n","for feature in df_lstm_pytorch_selected.columns:\n","    scaler = MinMaxScaler(feature_range=(-1, 1))\n","    feature_values = df_lstm_pytorch_selected[[feature]].values\n","    scalers_pytorch_lstm[feature] = scaler.fit(feature_values)\n","    df_lstm_pytorch_selected[feature] = scaler.transform(feature_values)\n","# Convert the scaled DataFrame to numpy array values.\n","df_lstm_pytorch_values = df_lstm_pytorch_selected.values\n","print(f\"Scaled feature data shape (df_lstm_pytorch_values): {df_lstm_pytorch_values.shape}\")\n","\n","# Prepare data into sequences\n","seq_len = 20\n","if len(df_lstm_pytorch_values) < seq_len:\n","    raise ValueError(f\"Not enough data to create sequences. Need at least {seq_len} rows after NaN removal, but only have {len(df_lstm_pytorch_values)}.\")\n","\n","sequence_data_pytorch = []\n","for index in range(len(df_lstm_pytorch_values) - seq_len + 1):\n","    sequence_data_pytorch.append(df_lstm_pytorch_values[index: index + seq_len])\n","sequence_data_pytorch = np.array(sequence_data_pytorch)\n","print(f\"Sequence data shape: {sequence_data_pytorch.shape}\")\n","\n","# --- Splitting the Data ---\n","print(f\"\\n{COLOR_START_STEP}--- Step B: Splitting the Data ---{COLOR_END}\")\n","\n","def split_data(sequence_array):\n","    train_size = int(len(sequence_array) * 0.8)\n","    val_test_size = len(sequence_array) - train_size\n","    val_size = int(val_test_size * 0.5)\n","\n","    if train_size == 0 or val_size == 0 or (len(sequence_array) - train_size - val_size) == 0:\n","        raise ValueError(\"Not enough data to split into train, validation, and test sets. Ensure you have enough cleaned data after sequence creation.\")\n","\n","    train_data = sequence_array[:train_size]\n","    val_data = sequence_array[train_size : train_size + val_size]\n","    test_data = sequence_array[train_size + val_size :]\n","\n","    return train_data, val_data, test_data\n","\n","try:\n","    train_data_pytorch, val_data_pytorch, test_data_pytorch = split_data(sequence_data_pytorch)\n","except ValueError as e:\n","    print(f\"Error during data splitting: {e}\")\n","    print(\"Please check your input data size and 'seq_len'.\")\n","    exit()\n","\n","print(f\"Train data shape: {train_data_pytorch.shape}\")\n","print(f\"Validation data shape: {val_data_pytorch.shape}\")\n","print(f\"Test data shape: {test_data_pytorch.shape}\")\n","\n","close_feature_index = features_to_scale.index('Close')\n","\n","x_train_pytorch = train_data_pytorch[:, :-1, :]\n","y_train_pytorch = train_data_pytorch[:, -1, close_feature_index]\n","x_valid_pytorch = val_data_pytorch[:, :-1, :]\n","y_valid_pytorch = val_data_pytorch[:, -1, close_feature_index]\n","x_test_pytorch = test_data_pytorch[:, :-1, :]\n","y_test_pytorch = test_data_pytorch[:, -1, close_feature_index] # This is the original y_test_pytorch before inverse transform\n","\n","print(f\"x_train_pytorch shape: {x_train_pytorch.shape}\")\n","print(f\"y_train_pytorch shape: {y_train_pytorch.shape}\")\n","print(f\"x_valid_pytorch shape: {x_valid_pytorch.shape}\")\n","print(f\"y_valid_pytorch shape: {y_valid_pytorch.shape}\")\n","print(f\"x_test_pytorch shape: {x_test_pytorch.shape}\")\n","print(f\"y_test_pytorch shape: {y_test_pytorch.shape}\")\n","\n","# --- FIX for Date Alignment ---\n","# The dates for y targets should align with the y_train, y_valid, y_test arrays\n","# `cleaned_dates_series` already starts after initial NaNs.\n","# We need to consider the `seq_len` offset for the start of actual sequences.\n","# The dates corresponding to the *last element* of each sequence (which is the target y)\n","# will be from `cleaned_dates_series` starting at `seq_len - 1` and extending to the end\n","# of the sequence_data_pytorch length.\n","\n","# Get the dates corresponding to the 'y' targets for all data (train, val, test)\n","# This `start_date_index_for_y_targets` correctly points to the date of the first y-target.\n","start_date_index_for_y_targets = seq_len - 1\n","all_actual_y_target_dates_pytorch = cleaned_dates_series.iloc[start_date_index_for_y_targets : start_date_index_for_y_targets + len(sequence_data_pytorch)].copy()\n","\n","# Ensure all_actual_y_target_dates_pytorch is timezone-aware and consistent\n","if all_actual_y_target_dates_pytorch.dt.tz is None:\n","    all_actual_y_target_dates_pytorch = all_actual_y_target_dates_pytorch.dt.tz_localize('UTC')\n","else:\n","    all_actual_y_target_dates_pytorch = all_actual_y_target_dates_pytorch.dt.tz_convert('UTC')\n","\n","\n","# Now, slice these dates according to the split lengths of your y_pytorch arrays\n","train_dates_for_plot_pytorch = all_actual_y_target_dates_pytorch.iloc[:len(y_train_pytorch)]\n","val_dates_for_plot_pytorch = all_actual_y_target_dates_pytorch.iloc[len(y_train_pytorch) : len(y_train_pytorch) + len(y_valid_pytorch)]\n","test_dates_y_pytorch = all_actual_y_target_dates_pytorch.iloc[len(y_train_pytorch) + len(y_valid_pytorch) : len(y_train_pytorch) + len(y_valid_pytorch) + len(y_test_pytorch)]\n","\n","# Verify lengths after fixing\n","print(f\"\\nVerifying lengths for plotting (after date alignment fix):\")\n","print(f\"len(train_dates_for_plot_pytorch): {len(train_dates_for_plot_pytorch)}, len(y_train_pytorch): {len(y_train_pytorch)}\")\n","print(f\"len(val_dates_for_plot_pytorch): {len(val_dates_for_plot_pytorch)}, len(y_valid_pytorch): {len(y_valid_pytorch)}\")\n","print(f\"len(test_dates_y_pytorch): {len(test_dates_y_pytorch)}, len(y_test_pytorch): {len(y_test_pytorch)}\")\n","\n","\n","# Adding noise to training data (with caution)\n","noise_factor = 0.01\n","x_train_pytorch_augmented = x_train_pytorch + np.random.normal(loc=0, scale=noise_factor, size=x_train_pytorch.shape)\n","# Make sure augmented data stays within the scaled range (-1, 1)\n","x_train_pytorch_augmented = np.clip(x_train_pytorch_augmented, -1, 1)\n","\n","\n","# Convert numpy arrays to PyTorch tensors\n","x_train_tensor = torch.tensor(x_train_pytorch_augmented).float() # Use augmented data\n","y_train_tensor = torch.tensor(y_train_pytorch).float()\n","x_valid_tensor = torch.tensor(x_valid_pytorch).float()\n","y_valid_tensor = torch.tensor(y_valid_pytorch).float()\n","x_test_tensor = torch.tensor(x_test_pytorch).float()\n","y_test_tensor = torch.tensor(y_test_pytorch).float() # Keep this as the target for calculating loss later\n","\n","# Create TensorDatasets\n","train_dataset = TensorDataset(x_train_tensor, y_train_tensor)\n","valid_dataset = TensorDataset(x_valid_tensor, y_valid_tensor)\n","test_dataset = TensorDataset(x_test_tensor, y_test_tensor)\n","\n","# Define batch size\n","batch_size = 16\n","\n","# Create DataLoaders\n","train_dataloader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)\n","val_dataloader = DataLoader(valid_dataset, batch_size=batch_size, shuffle=False)\n","test_dataloader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False)\n","\n","# --- Step C: Defining and Training the LSTM Model in PyTorch ---\n","print(f\"\\n{COLOR_START_STEP}--- Step C: Defining and Training the LSTM Model (PyTorch) ---{COLOR_END}\")\n","\n","# Device configuration\n","device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","print(f\"Using device: {device}\")\n","\n","# Neural Network Class (from your guidelines)\n","class NeuralNetwork(nn.Module):\n","    def __init__(self, input_size, hidden_size, output_size, num_layers=2, dropout_prob=0.3):\n","        super(NeuralNetwork, self).__init__()\n","        # input_size: number of features per time step (x_train.shape[2])\n","        # hidden_size: number of hidden units in LSTM (e.g., 64)\n","        self.lstm = nn.LSTM(input_size, hidden_size, num_layers=num_layers, batch_first=True, dropout=dropout_prob if num_layers > 1 else 0)\n","        self.dropout = nn.Dropout(p=dropout_prob)\n","        # The output of LSTM is (batch_size, seq_len, hidden_size)\n","        # For predicting the next single step, we take the last hidden state\n","        # which is hidden[-1] from (hn, cn) tuple.\n","        self.fc = nn.Linear(hidden_size, output_size)\n","\n","    def forward(self, x):\n","        # x shape: (batch_size, seq_len, input_size)\n","        output, (hidden, cell) = self.lstm(x)\n","        # hidden shape: (num_layers * num_directions, batch_size, hidden_size)\n","        # For a single-layer, unidirectional LSTM, hidden[-1] is the last hidden state for each sample\n","        x = self.dropout(hidden[-1]) # Apply dropout to the last hidden state\n","        x = self.fc(x)\n","        return x\n","\n","# Model parameters\n","input_features = x_train_pytorch.shape[2] # Number of features per time step\n","lstm_hidden_size = 256  \n","output_features = 1 # We are predicting only the 'Close' price\n","\n","# Create the model instance\n","model_pytorch_lstm = NeuralNetwork(input_features, lstm_hidden_size, output_features).to(device)\n","\n","# Loss function and optimizer \n","criterion = nn.MSELoss()\n","optimizer = optim.Adam(model_pytorch_lstm.parameters())\n","epochs = 50 \n","\n","# Training and Evaluation functions\n","def train(model, dataloader, optimizer, criterion, device):\n","    model.train()\n","    epoch_loss = 0\n","\n","    for inputs, target in dataloader:\n","        inputs, target = inputs.to(device), target.to(device)\n","\n","        optimizer.zero_grad()\n","        prediction = model(inputs)\n","        target = target.unsqueeze(-1) # Reshape target to match prediction shape (batch_size, 1)\n","        loss = criterion(prediction, target)\n","\n","        loss.backward()\n","        optimizer.step()\n","\n","        epoch_loss += loss.item()\n","\n","    return epoch_loss / len(dataloader) # Return average loss per batch\n","\n","def evaluate(model, dataloader, criterion, device):\n","    model.eval()\n","    epoch_loss = 0\n","\n","    with torch.no_grad():\n","        for inputs, target in dataloader:\n","            inputs, target = inputs.to(device), target.to(device)\n","            prediction = model(inputs)\n","            target = target.unsqueeze(-1) # Reshape target to match prediction shape\n","            loss = criterion(prediction, target)\n","\n","            epoch_loss += loss.item()\n","\n","    return epoch_loss / len(dataloader)\n","\n","\n","train_losses_pytorch = []\n","valid_losses_pytorch = []\n","best_val_loss = float('inf')\n","patience_counter = 0\n","early_stopping_patience = 5 # Increased significantly to allow more learning\n","reduce_lr_patience = 3 # Adjusted to be less than or equal to early_stopping_patience\n","factor_lr = 0.5 # Less aggressive reduction in learning rate\n","min_lr = 0.00001\n","\n","\n","print(\"Training PyTorch LSTM model...\")\n","for epoch in range(1, epochs + 1):\n","    # Training\n","    train_loss = train(model_pytorch_lstm, train_dataloader, optimizer, criterion, device)\n","    train_losses_pytorch.append(train_loss)\n","\n","    # Validation\n","    valid_loss = evaluate(model_pytorch_lstm, val_dataloader, criterion, device)\n","    valid_losses_pytorch.append(valid_loss)\n","\n","    # Print epoch statistics\n","    print(f'Epoch [{epoch}/{epochs}], Train Loss: {train_loss:.4f}, Valid Loss: {valid_loss:.4f}')\n","\n","    # Early Stopping\n","    if valid_loss < best_val_loss:\n","        best_val_loss = valid_loss\n","        patience_counter = 0\n","        # Save best model\n","        torch.save(model_pytorch_lstm.state_dict(), 'best_pytorch_lstm_model.pth')\n","    else:\n","        patience_counter += 1\n","        if patience_counter >= early_stopping_patience:\n","            print(f\"Early stopping at epoch {epoch} as validation loss did not improve for {early_stopping_patience} epochs.\")\n","            break\n","\n","    # Reduce Learning Rate on Plateau (simplified)\n","    # This would require more sophisticated tracking if you want to perfectly mimic ReduceLROnPlateau\n","    # For now, we'll just print a message if the validation loss plateaus for a longer period.\n","    # A full implementation would involve checking if a new min_lr is reached and updating optimizer.param_groups[0]['lr']\n","    if patience_counter >= reduce_lr_patience:\n","        current_lr = optimizer.param_groups[0]['lr']\n","        new_lr = max(current_lr * factor_lr, min_lr)\n","        if new_lr < current_lr:\n","            optimizer.param_groups[0]['lr'] = new_lr\n","            print(f\"Learning rate reduced to {new_lr:.6f} at epoch {epoch}\")\n","            patience_counter = 0 # Reset patience after LR reduction\n","\n","\n","print(\"\\nModel training complete.\")\n","# Load the best model weights\n","model_pytorch_lstm.load_state_dict(torch.load('best_pytorch_lstm_model.pth'))\n","model_pytorch_lstm.eval() # Set to evaluation mode\n","\n","# --- Step D: Prediction and Evaluation (PyTorch) ---\n","print(f\"\\n{COLOR_START_STEP}--- Step D: Prediction and Evaluation (PyTorch) ---{COLOR_END}\")\n","\n","print(\"Predicting on the test data...\")\n","y_pred_scaled_pytorch = []\n","with torch.no_grad():\n","    for inputs, _ in test_dataloader: # Note: target '_' is not used here as we only predict\n","        inputs = inputs.to(device)\n","        predictions = model_pytorch_lstm(inputs)\n","        y_pred_scaled_pytorch.extend(predictions.cpu().numpy())\n","\n","y_pred_scaled_pytorch = np.array(y_pred_scaled_pytorch).flatten()\n","\n","# Evaluate test loss\n","# For evaluation, we pass the full test_dataloader which includes both inputs and targets\n","test_loss_pytorch = evaluate(model_pytorch_lstm, test_dataloader, criterion, device)\n","print(f\"Test Loss (MSE): {test_loss_pytorch:.4f}\")\n","\n","scaler_close = scalers_pytorch_lstm['Close']\n","y_test_original_pytorch = scaler_close.inverse_transform(y_test_pytorch.reshape(-1, 1))\n","y_pred_original_pytorch = scaler_close.inverse_transform(y_pred_scaled_pytorch.reshape(-1, 1))\n","\n","rmse_pytorch = np.sqrt(mean_squared_error(y_test_original_pytorch, y_pred_original_pytorch))\n","mae_pytorch = np.mean(np.abs(y_test_original_pytorch - y_pred_original_pytorch))\n","print(f\"RMSE (Original Scale): {rmse_pytorch:.4f}\")\n","print(f\"MAE (Original Scale): {mae_pytorch:.4f}\")\n","\n","# --- Step E: Enhanced Plotting of Predictions (PyTorch) ---\n","print(f\"\\n{COLOR_START_STEP}--- Step E: Enhanced Plotting of Predictions (PyTorch) ---{COLOR_END}\")\n","\n","plt.figure(figsize=(18, 9), facecolor='white')\n","ax = plt.gca()\n","ax.set_facecolor('white')\n","\n","# Inverse transform y_train_pytorch for plotting\n","y_train_original_pytorch = scaler_close.inverse_transform(y_train_pytorch.reshape(-1,1))\n","\n","ax.plot(train_dates_for_plot_pytorch, y_train_original_pytorch, label='Training Data (Actual)', color=custom_plot_colors[0], linewidth=2.5, alpha=0.9)\n","ax.plot(test_dates_y_pytorch, y_test_original_pytorch, label='Test Data (Actual)', color=custom_plot_colors[1], linewidth=2.5, alpha=0.9)\n","ax.plot(test_dates_y_pytorch, y_pred_original_pytorch, label='PyTorch LSTM Predictions (Test Set)', color=custom_plot_colors[2], linestyle='--', linewidth=2.5)\n","\n","if not train_dates_for_plot_pytorch.empty and not test_dates_y_pytorch.empty:\n","    last_train_actual = y_train_original_pytorch[-1][0]\n","    first_test_actual = y_test_original_pytorch[0][0]\n","    ax.plot([train_dates_for_plot_pytorch.iloc[-1], test_dates_y_pytorch.iloc[0]], [last_train_actual, first_test_actual],\n","            color=custom_plot_colors[1], linestyle=':', linewidth=1.5, alpha=0.6, label='_nolegend_')\n","\n","\n","ax.set_title('Bitcoin Close Price: PyTorch LSTM Model Predictions vs Actuals (with Indicators)', fontsize=20, color='#333333', fontweight='bold')\n","ax.set_xlabel('Date', fontsize=16, color='#555555')\n","ax.set_ylabel('Close Price (USD)', fontsize=16, color='#555555')\n","ax.legend(fontsize=13, loc='upper left', frameon=True, shadow=True, fancybox=True)\n","ax.grid(True, linestyle='--', alpha=0.6)\n","\n","\n","# --- Forecasting for the next 10 days (PyTorch) ---\n","print(f\"\\n{COLOR_START_TITLE}--- Forecasting Next 10 Days (PyTorch LSTM) ---{COLOR_END}\")\n","n_forecast_steps = 10\n","\n","# Last date for actual data (from test set)\n","last_data_date = test_dates_y_pytorch.iloc[-1]\n","\n","future_dates_list = [last_data_date + datetime.timedelta(days=i) for i in range(1, n_forecast_steps + 1)]\n","future_dates = pd.DatetimeIndex(future_dates_list) # Create DatetimeIndex directly\n","# Ensure future_dates has consistent timezone with all_actual_y_target_dates_pytorch\n","if all_actual_y_target_dates_pytorch.dt.tz is not None and future_dates.tz is None: # .tz for DatetimeIndex\n","    future_dates = future_dates.tz_localize(all_actual_y_target_dates_pytorch.dt.tz) # .dt.tz for Series\n","elif all_actual_y_target_dates_pytorch.dt.tz is None and future_dates.tz is not None:\n","    future_dates = future_dates.tz_convert(None)\n","\n","\n","future_forecast_scaled_pytorch = []\n","# Get the last sequence from x_test and convert to tensor\n","# Need to use `x_test_pytorch` for the *last complete sequence*\n","# `x_test_pytorch` contains sequences of length `seq_len - 1`\n","last_known_sequence_features = x_test_pytorch[-1:] # Shape: (1, seq_len-1, num_features)\n","last_known_sequence_tensor = torch.tensor(last_known_sequence_features).float().to(device)\n","\n","\n","# For the iterative forecasting, we need to carefully update the sequence.\n","# The original features_to_scale defines the order of columns.\n","# We need to maintain that order when creating the new feature vector for the next step.\n","# last_data_point_original_scaled will represent the scaled values of the *last known actual day* (the day before the first forecast)\n","# This will be used to construct the input for the first forecast, and then the forecasted Close price will replace it.\n","\n","# To get the actual last scaled day's features from df_lstm_pytorch_selected:\n","# The last actual date in the test set is `test_dates_y_pytorch.iloc[-1]`.\n","# The sequence leading up to this date is `x_test_pytorch[-1]`.\n","# The actual Close price for this date is `y_test_pytorch[-1]`.\n","\n","# When predicting for the *next* day, the input sequence will be the last `seq_len - 1` historical data points.\n","# The `last_known_sequence_tensor` already holds `seq_len - 1` steps.\n","# The prediction `predicted_next_step_scaled` is for the `seq_len`-th step's Close price.\n","\n","# The subsequent steps in forecasting become more complex because we only predict Close.\n","# We'll need to use the last *actual* known Open, High, Low, Volume, and indicators\n","# and then replace the 'Close' value with our prediction.\n","\n","# Initialize the rolling forecast input with the last actual sequence from x_test\n","current_forecast_input_sequence = last_known_sequence_tensor.clone()\n","\n","for _ in range(n_forecast_steps):\n","    # Predict the next Close price\n","    predicted_next_close_scaled_tensor = model_pytorch_lstm(current_forecast_input_sequence) # (1, 1) output\n","    predicted_next_close_scaled = predicted_next_close_scaled_tensor.item()\n","    future_forecast_scaled_pytorch.append(predicted_next_close_scaled) # .item() for scalar\n","\n","    # Construct the next time step's feature vector for the *next* iteration's input sequence\n","    # This is a simplification: we're using the last known actual values for all features EXCEPT Close,\n","    # for the synthetic \"next\" day's input feature vector.\n","    # A more robust forecast would predict all features or use an auxiliary model for them.\n","\n","    # Get the last feature vector from the *original scaled dataframe* (df_lstm_pytorch_selected)\n","    # corresponding to the last actual date, and modify its 'Close' value.\n","    # The `df_lstm_pytorch_values` holds the scaled values.\n","    # The last row of `df_lstm_pytorch_values` corresponds to `cleaned_dates_series.iloc[-1]`\n","    # and also to `all_actual_y_target_dates_pytorch.iloc[-1]` (the last date in `test_dates_y_pytorch`).\n","    # So, `df_lstm_pytorch_values[len(sequence_data_pytorch) + seq_len - 2]` would be the last full row of features used for the final test prediction target.\n","    # A simpler approach is to take the *last full feature vector* from `df_lstm_pytorch_selected`\n","    # or the last element of the input sequence, and update its close.\n","\n","    # Option 1: Take the last feature set of the *current* sequence and update its Close\n","    # This means the *last time step* of `current_forecast_input_sequence` is modified.\n","    new_step_features_scaled = current_forecast_input_sequence[0, -1, :].clone() # Copy the last feature vector from the current sequence\n","    new_step_features_scaled[close_feature_index] = predicted_next_close_scaled # Update the 'Close' feature with the prediction\n","\n","    # Option 2 (More robust for complex features): If some features follow a trend or are static,\n","    # you'd need to handle them differently. For simplicity, we assume other features can be carried over.\n","    # Here, we are replacing the last known 'Close' in the sequence with the predicted 'Close'\n","    # and sliding the window. This is the most common way for single-feature predictions.\n","\n","    # Update the sequence: remove the first step, append the new step (with updated Close)\n","    # new_step_features_scaled is (num_features,), need to reshape to (1, 1, num_features) for torch.cat\n","    current_forecast_input_sequence = torch.cat((current_forecast_input_sequence[:, 1:, :],\n","                                                 new_step_features_scaled.reshape(1, 1, -1)), dim=1)\n","\n","\n","future_forecast_original_pytorch = scaler_close.inverse_transform(np.array(future_forecast_scaled_pytorch).reshape(-1, 1))\n","future_forecast_series_pytorch = pd.Series(future_forecast_original_pytorch.flatten(), index=future_dates)\n","\n","ax.plot(future_forecast_series_pytorch.index, future_forecast_series_pytorch, label=f'PyTorch LSTM Forecasted Next {n_forecast_steps} Days', color=custom_plot_colors[3], linestyle='-', linewidth=2, alpha=0.8)\n","\n","print(\"Future Forecast (Next 10 Days - Original Scale):\")\n","print(future_forecast_series_pytorch)\n","\n","# --- Inset Plot (Zoomed-in View) (PyTorch) ---\n","inset_ax = ax.inset_axes([0.15, 0.55, 0.40, 0.40], facecolor='white')\n","inset_ax.set_facecolor('white')\n","\n","# Adjust zoom_start_date_inset to ensure there's enough data for the zoom\n","# Let's make it more dynamic, e.g., last 3 months of test data + forecast\n","zoom_start_date_inset = test_dates_y_pytorch.iloc[-(len(test_dates_y_pytorch) // 4) if len(test_dates_y_pytorch) >= 4 else 0] # Start at 1/4 of test data, or start if not enough\n","# Make sure it's timezone aware\n","if all_actual_y_target_dates_pytorch.dt.tz is not None and zoom_start_date_inset.tz is None:\n","    zoom_start_date_inset = zoom_start_date_inset.tz_localize(all_actual_y_target_dates_pytorch.dt.tz)\n","elif all_actual_y_target_dates_pytorch.dt.tz is None and zoom_start_date_inset.tz is not None:\n","    zoom_start_date_inset = zoom_start_date_inset.tz_convert(None)\n","\n","\n","zoom_end_date_inset_plot = future_dates[-1]\n","\n","# Get all actual Y values (train, valid, test) and inverse transform them\n","all_actual_y_scaled_pytorch = np.concatenate((y_train_pytorch, y_valid_pytorch, y_test_pytorch))\n","full_actuals_series_with_dates_pytorch = pd.Series(scaler_close.inverse_transform(all_actual_y_scaled_pytorch.reshape(-1,1)).flatten(), index=all_actual_y_target_dates_pytorch)\n","\n","# Get all predictions (train, valid, test)\n","y_train_pred_scaled_pytorch = []\n","with torch.no_grad():\n","    for inputs, _ in train_dataloader:\n","        inputs = inputs.to(device)\n","        predictions = model_pytorch_lstm(inputs)\n","        y_train_pred_scaled_pytorch.extend(predictions.cpu().numpy())\n","y_train_pred_scaled_pytorch = np.array(y_train_pred_scaled_pytorch).flatten()\n","\n","\n","y_valid_pred_scaled_pytorch = []\n","with torch.no_grad():\n","    for inputs, _ in val_dataloader:\n","        inputs = inputs.to(device)\n","        predictions = model_pytorch_lstm(inputs)\n","        y_valid_pred_scaled_pytorch.extend(predictions.cpu().numpy())\n","y_valid_pred_scaled_pytorch = np.array(y_valid_pred_scaled_pytorch).flatten()\n","\n","all_predictions_scaled_pytorch = np.concatenate((y_train_pred_scaled_pytorch, y_valid_pred_scaled_pytorch, y_pred_scaled_pytorch))\n","full_predictions_series_with_dates_pytorch = pd.Series(scaler_close.inverse_transform(all_predictions_scaled_pytorch.reshape(-1,1)).flatten(), index=all_actual_y_target_dates_pytorch) # Reshape here too\n","\n","combined_predictions_and_forecast_pytorch = pd.concat([full_predictions_series_with_dates_pytorch, future_forecast_series_pytorch])\n","\n","zoom_actuals_series_pytorch = full_actuals_series_with_dates_pytorch.loc[zoom_start_date_inset : zoom_end_date_inset_plot]\n","zoom_predictions_series_pytorch = combined_predictions_and_forecast_pytorch.loc[zoom_start_date_inset : zoom_end_date_inset_plot]\n","\n","inset_ax.plot(zoom_actuals_series_pytorch.index, zoom_actuals_series_pytorch, label='Actuals (Zoom)', color=custom_plot_colors[1], linewidth=2.0)\n","inset_ax.plot(zoom_predictions_series_pytorch.index, zoom_predictions_series_pytorch, label='Predictions (Zoom)', color=custom_plot_colors[2], linestyle='--', linewidth=2.0)\n","\n","inset_ax.set_title(f'Zoom: {zoom_start_date_inset.strftime(\"%Y-%m-%d\")} to {zoom_end_date_inset_plot.strftime(\"%Y-%m-%d\")}', fontsize=12, color='#333333')\n","inset_ax.legend(fontsize=8, loc='upper left')\n","inset_ax.grid(True, linestyle='--', alpha=0.5)\n","\n","inset_ax.set_xlim(zoom_start_date_inset, zoom_end_date_inset_plot)\n","\n","all_data_for_zoom_y_pytorch = pd.concat([zoom_actuals_series_pytorch, zoom_predictions_series_pytorch]).dropna()\n","if not all_data_for_zoom_y_pytorch.empty:\n","    min_y_zoom = all_data_for_zoom_y_pytorch.min() * 0.98\n","    max_y_zoom = all_data_for_zoom_y_pytorch.max() * 1.02\n","    inset_ax.set_ylim(min_y_zoom, max_y_zoom)\n","\n","ax.indicate_inset_zoom(inset_ax, edgecolor=\"black\", linewidth=1.5, linestyle=':')\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# --- Step F: Plotting Loss Curves (PyTorch) ---\n","print(f\"\\n{COLOR_START_STEP}--- Step F: Plotting Loss Curves (PyTorch) ---{COLOR_END}\")\n","plt.figure(figsize=(10, 5), facecolor='white')\n","ax = plt.gca()\n","ax.set_facecolor('white')\n","\n","plt.plot(train_losses_pytorch, label='Training Loss', color=custom_plot_colors[0], marker='o', linestyle='--', markersize=4)\n","plt.plot(valid_losses_pytorch, label='Validation Loss', color=custom_plot_colors[1], marker='x', linestyle='-', markersize=4)\n","\n","plt.title('Loss Curves (PyTorch LSTM)', fontsize=16, color='#333333')\n","plt.xlabel('Epochs', fontsize=14, color='#555555')\n","plt.ylabel('Loss', fontsize=14, color='#555555')\n","plt.legend(fontsize=12)\n","plt.grid(True)\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# --- Step G: Model Summary and Architecture Visualization (PyTorch) ---\n","print(f\"\\n{COLOR_START_STEP}--- Step G: Model Summary and Architecture Visualization (PyTorch) ---{COLOR_END}\")\n","print(\"\\n### PyTorch Model Summary ###\")\n","# Print model architecture\n","print(model_pytorch_lstm)\n","\n","# For PyTorch model visualization with torchviz, you need to install it: pip install torchviz\n","# Then, you can try to visualize it if it's available.\n","try:\n","    from torchviz import make_dot\n","    # Generate a dummy input tensor for visualization\n","    # (batch_size, sequence_length, num_features)\n","    dummy_input = torch.randn(1, x_train_pytorch.shape[1], input_features).to(device)\n","    dummy_output = model_pytorch_lstm(dummy_input)\n","    graph = make_dot(dummy_output, params=dict(model_pytorch_lstm.named_parameters()))\n","    graph.render(\"model_pytorch_lstm_architecture\", format=\"png\", cleanup=True) # Added cleanup=True to remove dot file\n","    print(\"\\nPyTorch model architecture saved as 'model_pytorch_lstm_architecture.png'.\")\n","    from IPython.display import Image, display\n","    display(Image(filename=\"model_pytorch_lstm_architecture.png\"))\n","except ImportError:\n","    print(\"\\nWARNING: torchviz not installed. Cannot plot PyTorch model architecture.\")\n","    print(\"Please install torchviz: pip install torchviz\")\n","except Exception as e:\n","    print(f\"\\nError plotting PyTorch model architecture: {e}\")\n","\n","\n","# --- Step H: Candlestick Chart of Predicted Prices (PyTorch) ---\n","print(f\"\\n{COLOR_START_STEP}--- Step H: Candlestick Chart of Predicted Prices (PyTorch) ---{COLOR_END}\")\n","print(\"NOTE: This model ('Close' as target only) predicts *only* the Close price.\")\n","print(\"To generate a candlestick chart, the 'Open', 'High', 'Low', and 'Volume' for the predicted period are typically\")\n","print(\"assumed to be the actual historical values for those dates, or derived from them. \")\n","print(\"Here, we use the actual historical Open, High, Low, and Volume from the test set for the dates being predicted,\")\n","print(\"and replace the 'Close' with our model's predicted 'Close' price.\")\n","\n","# Prepare df_lstm_pytorch['Date'] for consistent lookup with test_dates_y (which is tz-aware)\n","# Ensure df_lstm_pytorch has the 'Date' column as its index or is used for lookup\n","# Make sure df_lstm_pytorch itself is consistent in timezone\n","if df_lstm_pytorch['Date'].dt.tz is None:\n","    df_lstm_pytorch['Date'] = df_lstm_pytorch['Date'].dt.tz_localize('UTC')\n","else:\n","    df_lstm_pytorch['Date'] = df_lstm_pytorch['Date'].dt.tz_convert('UTC')\n","\n","\n","# Create a temporary df for predictions\n","pred_df_for_merge = pd.DataFrame({\n","    'Date': test_dates_y_pytorch,\n","    'Predicted_Close': y_pred_original_pytorch.flatten()\n","})\n","# No need to tz_localize again, test_dates_y_pytorch is already tz-aware UTC\n","\n","\n","# Merge original OHLCV data for test dates with predicted close\n","# We need the original OHLCV values for the test dates\n","actual_ohlcv_test_dates = df_lstm_pytorch[df_lstm_pytorch['Date'].isin(test_dates_y_pytorch)].copy()\n","actual_ohlcv_test_dates['Date'] = actual_ohlcv_test_dates['Date'].dt.tz_convert('UTC') # Ensure consistency\n","\n","# *** CRITICAL FIX HERE: Include 'Volume' in the selection ***\n","final_df_plotly_pytorch = pd.merge(actual_ohlcv_test_dates[['Date', 'Open', 'High', 'Low', 'Close', 'Volume']], # ADDED 'Volume'\n","                                    pred_df_for_merge,\n","                                    on='Date',\n","                                    how='inner')\n","final_df_plotly_pytorch['Close'] = final_df_plotly_pytorch['Predicted_Close']\n","final_df_plotly_pytorch.drop(columns=['Predicted_Close'], inplace=True)\n","final_df_plotly_pytorch.set_index('Date', inplace=True)\n","final_df_plotly_pytorch.index.name = 'Date' # Ensure index name is correct after set_index\n","\n","\n","candlestick_trace_pytorch = go.Candlestick(\n","    x=final_df_plotly_pytorch.index,\n","    open=final_df_plotly_pytorch['Open'],\n","    high=final_df_plotly_pytorch['High'],\n","    low=final_df_plotly_pytorch['Low'],\n","    close=final_df_plotly_pytorch['Close'],\n","    name='Candlestick',\n","    increasing_line_color='black',\n","    decreasing_line_color='red',\n",")\n","\n","fig_plotly_pytorch = go.Figure(data=[candlestick_trace_pytorch])\n","\n","fig_plotly_pytorch.update_layout(\n","    title='Predicted Candlestick Chart (Test Set - PyTorch LSTM Close Only, with Indicators)',\n","    xaxis_title='Date',\n","    yaxis_title='Price',\n","    xaxis_rangeslider_visible=False,\n","    template='plotly_white',\n","    height=600,\n","    width=1000,\n","    plot_bgcolor='white',\n","    paper_bgcolor='white'\n",")\n","fig_plotly_pytorch.show()\n","\n","\n","# --- Step I: Candlestick Forecast for Next 10 Days (PyTorch) ---\n","print(f\"\\n{COLOR_START_STEP}--- Step I: Candlestick Forecast for Next {n_forecast_steps} Days (PyTorch) ---{COLOR_END}\")\n","print(\"NOTE: This chart combines actual Open, High, Low, Volume from the last known date\")\n","print(\"with the forecasted Close price. This is a highly simplified representation of future candles.\")\n","\n","# Get the last full OHLCV values from the original df_lstm_pytorch, corresponding to last_data_date\n","# This means the row in df_lstm_pytorch where 'Date' matches `test_dates_y_pytorch.iloc[-1]`\n","last_ohlcv_values_original_df = df_lstm_pytorch[df_lstm_pytorch['Date'] == test_dates_y_pytorch.iloc[-1]]\n","if not last_ohlcv_values_original_df.empty:\n","    last_ohlcv_values_original = last_ohlcv_values_original_df[['Open', 'High', 'Low', 'Volume']].values[0] # Get the numpy array\n","else:\n","    print(\"Warning: Could not find last_data_date in df_lstm_pytorch. Using dummy OHLCV for forecast.\")\n","    # Provide a fallback if the last date isn't found\n","    las