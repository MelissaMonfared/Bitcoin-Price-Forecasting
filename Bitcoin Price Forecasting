ate\"}},\"title\":{\"text\":\"Predicted Candlestick Chart for Next 10 Days (LSTM Close Only, with Indicators)\"},\"yaxis\":{\"title\":{\"text\":\"Price\"}},\"height\":600,\"width\":1000,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\"},                        {\"responsive\": true}                    ).then(function(){\n","                            \n","var gd = document.getElementById('41df5e1c-61c6-43b5-b196-0b9b7be79cff');\n","var x = new MutationObserver(function (mutations, observer) {{\n","        var display = window.getComputedStyle(gd).display;\n","        if (!display || display === 'none') {{\n","            console.log([gd, 'removed!']);\n","            Plotly.purge(gd);\n","            observer.disconnect();\n","        }}\n","}});\n","\n","// Listen for the removal of the full notebook cells\n","var notebookContainer = gd.closest('#notebook-container');\n","if (notebookContainer) {{\n","    x.observe(notebookContainer, {childList: true});\n","}}\n","\n","// Listen for the clearing of the current output cell\n","var outputEl = gd.closest('.output');\n","if (outputEl) {{\n","    x.observe(outputEl, {childList: true});\n","}}\n","\n","                        })                };                            </script>        </div>\n","</body>\n","</html>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","\u001b[92m--- Step H: Candlestick Chart of Predicted Prices (mplfinance) ---\u001b[0m\n","NOTE: This model ('Close' as target only) predicts *only* the Close price.\n","The 'Open', 'High', 'Low', and 'Volume' for the predicted period are taken from the actual historical values.\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1400x800 with 4 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","\u001b[96m--- LSTM Model 1 (Close Only, with Indicators) Process Complete ---\u001b[0m\n"]}],"source":["custom_plot_colors = ['#264653', '#287271', '#2a9d8f', '#e9c46a', '#efb366', '#f4a261', '#ee8951', '#e76f51']\n","\n","# ANSI escape codes for text coloring\n","COLOR_START_TITLE = \"\\033[96m\" # Light Cyan for section titles\n","COLOR_START_STEP = \"\\033[92m\"  # Green for step titles\n","COLOR_END = \"\\033[0m\"          # Reset color\n","\n","# Convert 'Date' column to datetime objects if not already\n","df['Date'] = pd.to_datetime(df['Date'])\n","# Localize 'Date' column to UTC (or convert to a consistent timezone)\n","# This is crucial for consistent date handling throughout the code.\n","if df['Date'].dt.tz is None: # Check if it's naive\n","    df['Date'] = df['Date'].dt.tz_localize('UTC') # Set to UTC\n","else: # If it already has a timezone, convert to UTC\n","    df['Date'] = df['Date'].dt.tz_convert('UTC')\n","\n","print(f\"Original df 'Date' column timezone: {df['Date'].dt.tz}\")\n","print(f\"Shape of your loaded df: {df.shape}\")\n","# --- End of Initial Date Column Setup ---\n","\n","\n","print(f\"{COLOR_START_TITLE}--- LSTM Model 1: Close Price Forecasting with All Indicators ---{COLOR_END}\")\n","print(f\"{COLOR_START_TITLE}Target: Only 'Close' Price{COLOR_END}\")\n","\n","# --- Data Preparation for LSTM ---\n","print(f\"\\n{COLOR_START_STEP}--- Step A: Data Preparation for LSTM ---{COLOR_END}\")\n","\n","# Create a deep copy of the original dataframe 'df' for LSTM Model 1\n","df_lstm_1 = df.copy(deep=True)\n","print(f\"Deep copy 'df_lstm_1' created. Original 'df' remains untouched for future models.\")\n","\n","# Select ALL relevant columns for this model based on your heatmap, plus 'Date'\n","# The order here defines the feature index later, especially for 'Close' target\n","# ENSURE all these features exist in YOUR 'df'\n","features_to_scale = [\n","    'Open', 'High', 'Low', 'Close', 'Volume', 'SMA7', 'SMA15', 'SMA30',\n","    'EMA7', 'EMA15', 'EMA30', 'RSI', 'Upper_Band', 'Lower_Band'\n","]\n","df_lstm_1_selected = df_lstm_1[features_to_scale + ['Date']].copy()\n","\n","# FIX: Drop rows with NaN values from the selected features and their corresponding dates.\n","# This is crucial as many indicators will have NaNs at the beginning due to rolling windows.\n","initial_rows_before_dropna = len(df_lstm_1_selected)\n","df_lstm_1_selected.dropna(inplace=True)\n","rows_dropped_by_dropna = initial_rows_before_dropna - len(df_lstm_1_selected)\n","print(f\"Removed {rows_dropped_by_dropna} rows with NaNs from selected features. New shape: {df_lstm_1_selected.shape}\")\n","\n","# FIX: Extract the cleaned dates series *after* dropna, before scaling features\n","cleaned_dates_series = df_lstm_1_selected['Date'].copy()\n","# Now drop 'Date' from df_lstm_1_selected as it's not a feature to be scaled\n","df_lstm_1_selected.drop(columns=['Date'], inplace=True)\n","\n","\n","# Initialize the MinMaxScaler. Scale each column individually.\n","scalers_lstm_1 = {}\n","for feature in features_to_scale:\n","    scaler = MinMaxScaler(feature_range=(-1, 1))\n","    scalers_lstm_1[feature] = scaler.fit(df_lstm_1_selected[feature].values.reshape(-1, 1))\n","    df_lstm_1_selected[feature] = scalers_lstm_1[feature].transform(df_lstm_1_selected[feature].values.reshape(-1, 1))\n","\n","# Convert the scaled DataFrame to numpy array values.\n","df_lstm_1_values = df_lstm_1_selected.values\n","print(f\"Scaled feature data shape (df_lstm_1_values): {df_lstm_1_values.shape}\")\n","\n","# Prepare data into sequences\n","seq_len = 20\n","if len(df_lstm_1_values) < seq_len:\n","    raise ValueError(f\"Not enough data to create sequences. Need at least {seq_len} rows after NaN removal, but only have {len(df_lstm_1_values)}.\")\n","\n","sequence_data = []\n","for index in range(len(df_lstm_1_values) - seq_len + 1):\n","    sequence_data.append(df_lstm_1_values[index: index + seq_len])\n","sequence_data = np.array(sequence_data)\n","print(f\"Sequence data shape: {sequence_data.shape}\")\n","\n","# --- Splitting the Data ---\n","print(f\"\\n{COLOR_START_STEP}--- Step B: Splitting the Data ---{COLOR_END}\")\n","\n","def split_data(sequence_array):\n","    train_size = int(len(sequence_array) * 0.8)\n","    val_test_size = len(sequence_array) - train_size\n","    val_size = int(val_test_size * 0.5)\n","\n","    if train_size == 0 or val_size == 0 or (len(sequence_array) - train_size - val_size) == 0:\n","        raise ValueError(\"Not enough data to split into train, validation, and test sets. Ensure you have enough cleaned data after sequence creation.\")\n","\n","    train_data = sequence_array[:train_size]\n","    val_data = sequence_array[train_size : train_size + val_size]\n","    test_data = sequence_array[train_size + val_size :]\n","\n","    return train_data, val_data, test_data\n","\n","try:\n","    train_data, val_data, test_data = split_data(sequence_data)\n","except ValueError as e:\n","    print(f\"Error during data splitting: {e}\")\n","    print(\"Please check your input data size and 'seq_len'.\")\n","    exit()\n","\n","print(f\"Train data shape: {train_data.shape}\")\n","print(f\"Validation data shape: {val_data.shape}\")\n","print(f\"Test data shape: {test_data.shape}\")\n","\n","close_feature_index = features_to_scale.index('Close')\n","\n","x_train = train_data[:, :-1, :]\n","y_train = train_data[:, -1, close_feature_index]\n","x_valid = val_data[:, :-1, :]\n","y_valid = val_data[:, -1, close_feature_index]\n","x_test = test_data[:, :-1, :]\n","y_test = test_data[:, -1, close_feature_index]\n","\n","print(f\"x_train shape: {x_train.shape}\")\n","print(f\"y_train shape: {y_train.shape}\")\n","print(f\"x_valid shape: {x_valid.shape}\")\n","print(f\"y_valid shape: {y_valid.shape}\")\n","print(f\"x_test shape: {x_test.shape}\")\n","print(f\"y_test shape: {y_test.shape}\")\n","\n","start_date_index_for_y_targets = seq_len - 1\n","all_target_y_dates = cleaned_dates_series.iloc[start_date_index_for_y_targets:].copy()\n","# Ensure all_target_y_dates is also timezone-aware and consistent with df['Date']\n","if all_target_y_dates.dt.tz is None: # Use .dt.tz for a Series\n","    all_target_y_dates = all_target_y_dates.dt.tz_localize('UTC')\n","else:\n","    all_target_y_dates = all_target_y_dates.dt.tz_convert('UTC')\n","\n","train_dates_for_plot = all_target_y_dates.iloc[:len(y_train)]\n","val_dates_for_plot = all_target_y_dates.iloc[len(y_train) : len(y_train) + len(y_valid)]\n","test_dates_y = all_target_y_dates.iloc[len(y_train) + len(y_valid) : len(y_train) + len(y_valid) + len(y_test)]\n","\n","noise_factor = 0.01 \n","x_train_augmented = x_train + np.random.normal(loc=0, scale=noise_factor, size=x_train.shape)\n","x_train_augmented = np.clip(x_train_augmented, -1, 1)\n","\n","# --- Step C: Defining and Training the LSTM Model ---\n","print(f\"\\n{COLOR_START_STEP}--- Step C: Defining and Training the LSTM Model ---{COLOR_END}\")\n","\n","model_lstm = Sequential()\n","model_lstm.add(LSTM(units=16, return_sequences=True,\n","                     input_shape=(x_train.shape[1], x_train.shape[2])))\n","model_lstm.add(Dropout(0.5))\n","model_lstm.add(Flatten()) \n","model_lstm.add(Dense(units=5))\n","model_lstm.add(Dense(units=1)) \n","\n","\n","model_lstm.compile(optimizer='adam', loss='mean_squared_error')\n","\n","early_stopping = EarlyStopping(monitor='val_loss', patience=5, restore_best_weights=True)\n","reduce_lr = ReduceLROnPlateau(monitor='val_loss', factor=0.3, patience=15, min_lr=0.00001)\n","\n","print(\"Training LSTM model...\")\n","history = model_lstm.fit(x_train, y_train, epochs=50, batch_size=32,\n","                            validation_data=(x_valid, y_valid),\n","                            callbacks=[early_stopping, reduce_lr],\n","                            verbose=1)\n","\n","print(\"\\nModel training complete.\")\n","\n","# --- Step D: Prediction and Evaluation ---\n","print(f\"\\n{COLOR_START_STEP}--- Step D: Prediction and Evaluation ---{COLOR_END}\")\n","\n","print(\"Predicting on the test data...\")\n","y_pred_scaled = model_lstm.predict(x_test, verbose=0)\n","\n","print(\"Evaluating test loss...\")\n","test_loss = model_lstm.evaluate(x_test, y_test, verbose=0)\n","print(f\"Test Loss (MSE): {test_loss:.4f}\")\n","\n","scaler_close = scalers_lstm_1['Close']\n","y_test_original = scaler_close.inverse_transform(y_test.reshape(-1, 1))\n","y_pred_original = scaler_close.inverse_transform(y_pred_scaled)\n","\n","rmse = np.sqrt(mean_squared_error(y_test_original, y_pred_original))\n","mae = np.mean(np.abs(y_test_original - y_pred_original))\n","print(f\"MAE (Original Scale): {mae:.4f}\")\n","\n","# --- Step E: Enhanced Plotting of Predictions ---\n","print(f\"\\n{COLOR_START_STEP}--- Step E: Enhanced Plotting of Predictions ---{COLOR_END}\")\n","\n","plt.figure(figsize=(18, 9), facecolor='white')\n","ax = plt.gca()\n","ax.set_facecolor('white')\n","\n","ax.plot(train_dates_for_plot, scaler_close.inverse_transform(y_train.reshape(-1,1)), label='Training Data (Actual)', color=custom_plot_colors[0], linewidth=2.5, alpha=0.9)\n","ax.plot(test_dates_y, y_test_original, label='Test Data (Actual)', color=custom_plot_colors[1], linewidth=2.5, alpha=0.9)\n","ax.plot(test_dates_y, y_pred_original, label='LSTM Predictions (Test Set)', color=custom_plot_colors[2], linestyle='--', linewidth=2.5)\n","\n","if not train_dates_for_plot.empty and not test_dates_y.empty:\n","    last_train_actual = scaler_close.inverse_transform(y_train.reshape(-1,1))[-1][0]\n","    first_test_actual = y_test_original[0][0]\n","    ax.plot([train_dates_for_plot.iloc[-1], test_dates_y.iloc[0]], [last_train_actual, first_test_actual],\n","            color=custom_plot_colors[1], linestyle=':', linewidth=1.5, alpha=0.6, label='_nolegend_')\n","\n","\n","ax.set_title('Bitcoin Close Price: LSTM Model Predictions vs Actuals (with Indicators)', fontsize=20, color='#333333', fontweight='bold')\n","ax.set_xlabel('Date', fontsize=16, color='#555555')\n","ax.set_ylabel('Close Price (USD)', fontsize=16, color='#555555')\n","ax.legend(fontsize=13, loc='upper left', frameon=True, shadow=True, fancybox=True)\n","ax.grid(True, linestyle='--', alpha=0.6)\n","\n","\n","# --- Forecasting for the next 10 days    ---\n","print(f\"\\n{COLOR_START_TITLE}--- Forecasting Next 10 Days (LSTM) ---{COLOR_END}\")\n","n_forecast_steps = 10\n","\n","last_data_date = test_dates_y.iloc[-1]\n","\n","future_dates_list = [last_data_date + datetime.timedelta(days=i) for i in range(1, n_forecast_steps + 1)]\n","future_dates = pd.DatetimeIndex(future_dates_list) # Create DatetimeIndex directly\n","# Ensure future_dates has consistent timezone with all_target_y_dates\n","if all_target_y_dates.dt.tz is not None and future_dates.tz is None: # .tz for DatetimeIndex\n","    future_dates = future_dates.tz_localize(all_target_y_dates.dt.tz) # .dt.tz for Series\n","elif all_target_y_dates.dt.tz is None and future_dates.tz is not None:\n","    future_dates = future_dates.tz_convert(None)\n","\n","future_forecast_scaled = []\n","last_known_sequence = x_test[-1].reshape(1, x_test.shape[1], x_test.shape[2])\n","\n","for _ in range(n_forecast_steps):\n","    predicted_next_step_scaled = model_lstm.predict(last_known_sequence, verbose=0)\n","    future_forecast_scaled.append(predicted_next_step_scaled[0, 0])\n","    \n","    new_sequence_features = np.copy(last_known_sequence[0, -1, :])\n","    new_sequence_features[close_feature_index] = predicted_next_step_scaled[0, 0]\n","    \n","    last_known_sequence = np.append(last_known_sequence[:, 1:, :], new_sequence_features.reshape(1, 1, -1), axis=1)\n","\n","future_forecast_original = scaler_close.inverse_transform(np.array(future_forecast_scaled).reshape(-1, 1))\n","future_forecast_series = pd.Series(future_forecast_original.flatten(), index=future_dates)\n","\n","ax.plot(future_forecast_series.index, future_forecast_series, label=f'LSTM Forecasted Next {n_forecast_steps} Days', color=custom_plot_colors[3], linestyle='-', linewidth=2, alpha=0.8)\n","\n","print(\"Future Forecast (Next 10 Days - Original Scale):\")\n","print(future_forecast_